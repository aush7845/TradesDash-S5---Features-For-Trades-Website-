PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/tradesdash
# MongoDB Atlas (cloud) example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradesdash?retryWrites=true&w=majority

# Frontend URL(s) allowed to call this API, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Secret for admin routes (sent as x-api-key header). Use a long random string.
# Leave empty to disable the admin routes completely.
ADMIN_API_KEY=change-me-to-a-long-random-string
